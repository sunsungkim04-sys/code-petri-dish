+
+static bool matOrgIdLess(cOrganism* a, cOrganism* b) { return a->GetID() < b->GetID(); }
+
+void cMatCounters::Clear()
+{
+  attempts = stalls = nodraw_stalls = draws = reused = err_draws = err_stalls = 0;
+  del = ins_written = sub_draws = sub_written = sub_changed = written = 0;
+  gap_sum = gap_n = divides = div_fail_mat = uncopied_mat = extra_ret = overwrite_ret = 0;
+  placed = dropped = placed_changed = placed_len = 0;
+}
+
+void cMatCounters::Add(const cMatCounters& o)
+{
+  attempts += o.attempts; stalls += o.stalls; nodraw_stalls += o.nodraw_stalls; draws += o.draws;
+  reused += o.reused; err_draws += o.err_draws; err_stalls += o.err_stalls; del += o.del;
+  ins_written += o.ins_written; sub_draws += o.sub_draws; sub_written += o.sub_written;
+  sub_changed += o.sub_changed; written += o.written; gap_sum += o.gap_sum; gap_n += o.gap_n;
+  divides += o.divides; div_fail_mat += o.div_fail_mat; uncopied_mat += o.uncopied_mat;
+  extra_ret += o.extra_ret; overwrite_ret += o.overwrite_ret; placed += o.placed; dropped += o.dropped;
+  placed_changed += o.placed_changed; placed_len += o.placed_len;
+}
+
+cMaterial::cMaterial(cWorld* world)
+  : m_suppress_death_return(false), m_suppress_inject_take(false)
+  , m_world(world), m_mode(world->GetConfig().MATERIAL_MODE.Get()), m_init(false)
+  , m_cells(0), m_nk(0), m_wx(0), m_wy(0), m_reach(4)
+  , m_audit_runs(0), m_audit_viol(0), m_anomalies(0), m_inject_skipped(0)
+  , m_census(NULL), m_audit(NULL)
+{
+}
+
+cMaterial::~cMaterial()
+{
+  closeOutputs();
+}
+
+int cMaterial::Rule() const { return m_world->GetConfig().COPY_DRAW_RULE.Get(); }
+double cMaterial::Q() const { return m_world->GetConfig().COPY_REDRAW_Q.Get(); }
+double cMaterial::PSub() const { return m_world->GetConfig().COPY_MAT_SUB_PROB.Get(); }
+double cMaterial::PIns() const { return m_world->GetConfig().COPY_MAT_INS_PROB.Get(); }
+double cMaterial::PDel() const { return m_world->GetConfig().COPY_MAT_DEL_PROB.Get(); }
+
+void cMaterial::seedStreams(uint64_t base)
+{
+  cMatRng mix(base);
+  m_copy_rng.Seed(mix.Next());
+  m_q_rng.Seed(mix.Next());
+  m_env_rng.Seed(mix.Next());
+}
+
+void cMaterial::checkGuards()
+{
+  cAvidaConfig& c = m_world->GetConfig();
+  std::ostringstream bad;
+  const double zero_vars[] = {
+    c.COPY_MUT_PROB.Get(), c.COPY_INS_PROB.Get(), c.COPY_DEL_PROB.Get(), c.COPY_UNIFORM_PROB.Get(), c.COPY_SLIP_PROB.Get(),
+    c.POINT_MUT_PROB.Get(), c.POINT_INS_PROB.Get(), c.POINT_DEL_PROB.Get(), c.INST_POINT_MUT_PROB.Get(),
+    c.DIV_MUT_PROB.Get(), c.DIV_INS_PROB.Get(), c.DIV_DEL_PROB.Get(), c.DIV_UNIFORM_PROB.Get(), c.DIV_SLIP_PROB.Get(),
+    c.DIV_TRANS_PROB.Get(), c.DIV_LGT_PROB.Get(),
+    c.DIVIDE_MUT_PROB.Get(), c.DIVIDE_INS_PROB.Get(), c.DIVIDE_DEL_PROB.Get(), c.DIVIDE_UNIFORM_PROB.Get(),
+    c.DIVIDE_SLIP_PROB.Get(), c.DIVIDE_TRANS_PROB.Get(), c.DIVIDE_LGT_PROB.Get(),
+    c.DIVIDE_POISSON_MUT_MEAN.Get(), c.DIVIDE_POISSON_INS_MEAN.Get(), c.DIVIDE_POISSON_DEL_MEAN.Get(),
+    c.DIVIDE_POISSON_SLIP_MEAN.Get(), c.DIVIDE_POISSON_TRANS_MEAN.Get(), c.DIVIDE_POISSON_LGT_MEAN.Get(),
+    c.INJECT_MUT_PROB.Get(), c.PARENT_MUT_PROB.Get(), c.PARENT_INS_PROB.Get(), c.PARENT_DEL_PROB.Get(),
+    c.META_COPY_MUT.Get()
+  };
+  for (size_t i = 0; i < sizeof(zero_vars) / sizeof(zero_vars[0]); i++) {
+    if (zero_vars[i] != 0.0) bad << " mutation-var#" << i << "=" << zero_vars[i];
+  }
+  if (c.SPECULATIVE.Get()) bad << " SPECULATIVE=1";
+  if (c.DIVIDE_METHOD.Get() != 1) bad << " DIVIDE_METHOD!=1";
+  if (m_mode != 2) bad << " MATERIAL_MODE must be 0 or 2";
+  if (c.MATERIAL_LIFESPAN.Get() > 0 && c.DEATH_METHOD.Get() != 0) bad << " MATERIAL_LIFESPAN needs DEATH_METHOD 0";
+  const int r = c.COPY_DRAW_RULE.Get();
+  if (r < 0 || r > 2) bad << " COPY_DRAW_RULE";
+  if (m_reach != 0 && m_reach != 4 && m_reach != 8) bad << " MATERIAL_REACH";
+  if (bad.str().size()) {
+    std::cerr << "[material] configuration not allowed with MATERIAL_MODE on:" << bad.str() << std::endl;
+    std::exit(3);
+  }
+}
+
+void cMaterial::EnsureInit()
+{
+  if (m_init || !Enabled()) return;
+  m_init = true;
+  cAvidaConfig& c = m_world->GetConfig();
+  m_reach = c.MATERIAL_REACH.Get();
+  checkGuards();
+  m_wx = c.WORLD_X.Get();
+  m_wy = c.WORLD_Y.Get();
+  m_cells = m_wx * m_wy;
+  m_nk = m_world->GetHardwareManager().GetDefaultInstSet().GetSize();
+  const bool torus = (c.WORLD_GEOMETRY.Get() == 2);
+  if (c.WORLD_GEOMETRY.Get() != 1 && c.WORLD_GEOMETRY.Get() != 2) {
+    std::cerr << "[material] WORLD_GEOMETRY must be 1 or 2" << std::endl;
+    std::exit(3);
+  }
+  m_nb.assign((size_t)m_cells * 8, -1);
+  const int dx[8] = { 0, 1, 0, -1, 1, 1, -1, -1 };
+  const int dy[8] = { -1, 0, 1, 0, -1, 1, 1, -1 };
+  for (int y = 0; y < m_wy; y++) for (int x = 0; x < m_wx; x++) {
+    for (int d = 0; d < 8; d++) {
+      int nx = x + dx[d], ny = y + dy[d];
+      if (torus) { nx = (nx + m_wx) % m_wx; ny = (ny + m_wy) % m_wy; }
+      else if (nx < 0 || ny < 0 || nx >= m_wx || ny >= m_wy) continue;
+      m_nb[(size_t)(y * m_wx + x) * 8 + d] = ny * m_wx + nx;
+    }
+  }
+  long long seed = c.MATERIAL_SEED.Get();
+  if (seed <= 0) seed = (long long)c.RANDOM_SEED.Get() * 2654435761LL + 0x5EEDLL;
+  seedStreams((uint64_t)seed);
+
+  m_pool.assign((size_t)m_cells * m_nk, 0);
+  const long long total = llround(m_cells * c.MATERIAL_DENSITY.Get());
+  for (long long t = 0; t < total; t++) {
+    const int cell = m_env_rng.Below(m_cells);
+    const int k = m_env_rng.Below(m_nk);
+    m_pool[(size_t)cell * m_nk + k]++;
+  }
+  m_init_kind.assign(m_nk, 0);
+  m_transit.assign(m_nk, 0);
+  for (int i = 0; i < m_cells; i++) for (int k = 0; k < m_nk; k++) m_init_kind[k] += m_pool[(size_t)i * m_nk + k];
+  {
+    const std::string f = (const char*)c.MATERIAL_CENSUS_FOUNDER.Get();
+    if (f.size() && f != "-") for (size_t i = 0; i < f.size(); i++) m_founder.push_back(f[i] - 'a');
+  }
+  m_prefix = (const char*)c.MATERIAL_CENSUS_FILE.Get();
+  openOutputs();
+  std::cerr << "[material] init cells=" << m_cells << " kinds=" << m_nk << " letters=" << total
+            << " reach=" << m_reach << " rule=" << Rule() << std::endl;
+}
+
+void cMaterial::openOutputs()
+{
+  if (m_prefix.size() == 0 || m_prefix == "-") return;
+  std::string cmd = "gzip -c > '" + m_prefix + ".census.gz'";
+  m_census = popen(cmd.c_str(), "w");
+  m_audit = fopen((m_prefix + ".audit.txt").c_str(), "w");
+  if (m_census) {
+    fprintf(m_census, "update label alive attempts stalls nodraw_stalls draws reused err_draws err_stalls del ins_written "
+                      "sub_draws sub_written sub_changed written gap_sum gap_n divides div_fail_mat uncopied_mat extra_ret "
+                      "overwrite_ret placed dropped placed_changed placed_len free_total\n");
+  }
+}
+
+void cMaterial::closeOutputs()
+{
+  if (m_census) { pclose(m_census); m_census = NULL; }
+  if (m_audit) { fclose(m_audit); m_audit = NULL; }
+}
+
+void cMaterial::FlushOutputs()
+{
+  if (m_census) fflush(m_census);
+  if (m_audit) fflush(m_audit);
+  fflush(stdout); fflush(stderr);
+  std::cout.flush(); std::cerr.flush();
+}
+
+void cMaterial::Anomaly(const char* what)
+{
+  m_anomalies++;
+  if (m_anomalies <= 20) std::cerr << "[material] ANOMALY " << what << std::endl;
+}
+
+bool cMaterial::Has(int cell, int k) const
+{
+  if (m_pool[(size_t)cell * m_nk + k] > 0) return true;
+  for (int d = 0; d < m_reach; d++) {
+    const int t = m_nb[(size_t)cell * 8 + d];
+    if (t >= 0 && m_pool[(size_t)t * m_nk + k] > 0) return true;
+  }
+  return false;
+}
+
+int cMaterial::Take(int cell, int k)
+{
+  int& own = m_pool[(size_t)cell * m_nk + k];
+  if (own > 0) { own--; return cell; }
+  for (int d = 0; d < m_reach; d++) {
+    const int t = m_nb[(size_t)cell * 8 + d];
+    if (t >= 0) {
+      int& v = m_pool[(size_t)t * m_nk + k];
+      if (v > 0) { v--; return t; }
+    }
+  }
+  return -1;
+}
+
+int cMaterial::TakeAnywhere(int k, cMatRng& rng)
+{
+  for (int t = 0; t < 200000; t++) {
+    const int cell = rng.Below(m_cells);
+    int& v = m_pool[(size_t)cell * m_nk + k];
+    if (v > 0) { v--; return cell; }
+  }
+  return -1;
+}
+
+int cMaterial::TakeNearThenAnywhere(int cell, int k, cMatRng& rng)
+{
+  const int at = Take(cell, k);
+  if (at >= 0) return at;
+  return TakeAnywhere(k, rng);
+}
+
+void cMaterial::TransitAdd(const std::vector<int>& kinds)
+{
+  for (size_t i = 0; i < kinds.size(); i++) m_transit[kinds[i]]++;
+}
+
+void cMaterial::TransitRemove(const std::vector<int>& kinds)
+{
+  for (size_t i = 0; i < kinds.size(); i++) m_transit[kinds[i]]--;
+}
+
+void cMaterial::TransitReturn(int cell, const std::vector<int>& kinds)
+{
+  for (size_t i = 0; i < kinds.size(); i++) { m_transit[kinds[i]]--; Put(cell, kinds[i]); }
+}
+
+std::vector<int> cMaterial::KindsOf(const Genome& genome)
+{
+  ConstInstructionSequencePtr seq;
+  seq.DynamicCastFrom(genome.Representation());
+  std::vector<int> out;
+  out.reserve(seq->GetSize());
+  for (int i = 0; i < seq->GetSize(); i++) out.push_back((*seq)[i].GetOp());
+  return out;
+}
+
+void cMaterial::OnDeath(cOrganism* org, int cell)
+{
+  if (!m_init) return;
+  if (m_suppress_death_return || m_world->GetConfig().MATERIAL_DEBUG_NO_DEATH_RETURN.Get()) {
+    org->GetHardware().MaterialDiscard();
+    return;
+  }
+  org->GetHardware().MaterialReleaseAll(*this, cell);
+}
+
+bool cMaterial::OnInject(cAvidaContext& ctx, int cell, const Genome& genome)
+{
+  EnsureInit();
+  if (!Enabled() || m_suppress_inject_take) return true;
+  cPopulation& pop = m_world->GetPopulation();
+  if (pop.GetCell(cell).IsOccupied()) pop.KillOrganism(pop.GetCell(cell), ctx);
+  const std::vector<int> kinds = KindsOf(genome);
+  const int policy = m_world->GetConfig().MATERIAL_INJECT_TAKE.Get();
+  std::vector<std::pair<int, int> > taken;
+  for (size_t i = 0; i < kinds.size(); i++) {
+    int at = -1;
+    if (policy == 0) at = TakeAnywhere(kinds[i], m_env_rng);
+    else if (policy == 1) at = TakeNearThenAnywhere(cell, kinds[i], m_env_rng);
+    else at = Take(cell, kinds[i]);
+    if (at < 0) {
+      for (size_t j = 0; j < taken.size(); j++) Put(taken[j].first, taken[j].second);
+      m_inject_skipped++;
+      std::cerr << "[material] inject skipped at cell " << cell << " (letter unavailable)" << std::endl;
+      return false;
+    }
+    taken.push_back(std::make_pair(at, kinds[i]));
+  }
+  return true;
+}
+
+void cMaterial::OnPlaced(cOrganism* parent, cOrganism* offspring)
+{
+  if (!m_init) return;
+  const std::vector<int> ok = KindsOf(offspring->GetGenome());
+  TransitRemove(ok);
+  cMatCounters& C = Ctr(parent->GetHardware().MaterialBucket(*this));
+  C.placed++;
+  C.placed_len += (long long)ok.size();
+  const std::vector<int> pk = KindsOf(parent->GetGenome());
+  if (pk != ok) C.placed_changed++;
+}
+
+void cMaterial::OnDropped(cOrganism* parent, cOrganism* offspring, int parent_cell)
+{
+  if (!m_init) return;
+  TransitReturn(parent_cell, KindsOf(offspring->GetGenome()));
+  Ctr(parent->GetHardware().MaterialBucket(*this)).dropped++;
+}
+
+long long cMaterial::Audit(bool force_print)
+{
+  if (!m_init) return 0;
+  std::vector<long long> now(m_nk, 0);
+  long long negatives = 0;
+  for (int i = 0; i < m_cells; i++) for (int k = 0; k < m_nk; k++) {
+    const int v = m_pool[(size_t)i * m_nk + k];
+    if (v < 0) negatives++;
+    now[k] += v;
+  }
+  long long held_total = 0;
+  const Apto::Array<cOrganism*, Apto::Smart>& live = m_world->GetPopulation().GetLiveOrgList();
+  for (int i = 0; i < live.GetSize(); i++) live[i]->GetHardware().MaterialAddHeld(now);
+  long long viol = negatives;
+  long long total = 0, init_total = 0;
+  for (int k = 0; k < m_nk; k++) {
+    now[k] += m_transit[k];
+    if (m_transit[k] != 0) viol++;      // between updates nothing may be in transit
+    if (now[k] != m_init_kind[k]) viol++;
+    total += now[k];
+    init_total += m_init_kind[k];
+  }
+  (void)held_total;
+  m_audit_runs++;
+  if (viol) m_audit_viol++;
+  if (m_audit && (viol || force_print)) {
+    fprintf(m_audit, "%d audit total=%lld init=%lld kind_or_neg_violations=%lld anomalies=%lld inject_skipped=%lld\n",
+            m_world->GetStats().GetUpdate(), total, init_total, viol, m_anomalies, m_inject_skipped);
+  }
+  if (viol && m_world->GetConfig().MATERIAL_AUDIT_ABORT.Get()) {
+    FlushOutputs();
+    std::cerr << "[material] AUDIT VIOLATION at update " << m_world->GetStats().GetUpdate()
+              << " total=" << total << " init=" << init_total << std::endl;
+    closeOutputs();
+    std::exit(4);
+  }
+  return viol;
+}
+
+void cMaterial::WriteCensus(int update)
+{
+  if (!m_census) return;
+  long long alive[MAX_LABEL];
+  for (int l = 0; l < MAX_LABEL; l++) alive[l] = 0;
+  const Apto::Array<cOrganism*, Apto::Smart>& live = m_world->GetPopulation().GetLiveOrgList();
+  for (int i = 0; i < live.GetSize(); i++) {
+    alive[live[i]->GetHardware().MaterialBucket(*this)]++;
+  }
+  long long free_total = 0;
+  for (size_t j = 0; j < m_pool.size(); j++) free_total += m_pool[j];
+  for (int l = 0; l < MAX_LABEL; l++) {
+    const cMatCounters& C = m_ctr[l];
+    if (alive[l] == 0 && C.attempts == 0 && C.placed == 0 && C.dropped == 0 && l > 1) continue;
+    fprintf(m_census, "%d %d %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld\n",
+            update, l, alive[l], C.attempts, C.stalls, C.nodraw_stalls, C.draws, C.reused, C.err_draws, C.err_stalls,
+            C.del, C.ins_written, C.sub_draws, C.sub_written, C.sub_changed, C.written, C.gap_sum, C.gap_n,
+            C.divides, C.div_fail_mat, C.uncopied_mat, C.extra_ret, C.overwrite_ret, C.placed, C.dropped,
+            C.placed_changed, C.placed_len, free_total);
+    m_ctr[l].Clear();
+  }
+}
+
+int cMaterial::DrawLifespan()
+{
+  const int a = m_world->GetConfig().MATERIAL_LIFESPAN.Get();
+  return a + m_env_rng.Below(a);
+}
+
+void cMaterial::PostUpdate(cAvidaContext& ctx)
+{
+  if (!Enabled()) return;
+  EnsureInit();
+  cAvidaConfig& c = m_world->GetConfig();
+  const int life_a = c.MATERIAL_LIFESPAN.Get();
+  const double pdeath = c.MATERIAL_DEATH_RATE.Get();
+  if (life_a > 0 || pdeath > 0) {
+    cPopulation& pop = m_world->GetPopulation();
+    const int now_u = m_world->GetStats().GetUpdate();
+    const Apto::Array<cOrganism*, Apto::Smart>& live = pop.GetLiveOrgList();
+    std::vector<int> doomed;
+    for (int i = 0; i < live.GetSize(); i++) {
+      bool die = false;
+      if (life_a > 0 && live[i]->GetHardware().MaterialLifeCheck(*this, now_u)) die = true;
+      if (pdeath > 0 && m_env_rng.Uniform() < pdeath) die = true;
+      if (die) doomed.push_back(live[i]->GetCellID());
+    }
+    for (size_t j = 0; j < doomed.size(); j++) pop.KillOrganism(pop.GetCell(doomed[j]), ctx);
+  }
+  const double rate = c.MATERIAL_DIFFUSE.Get();
+  if (rate > 0) {
+    const int n = (int)(m_cells * rate);
+    for (int q = 0; q < n; q++) {
+      const int i = m_env_rng.Below(m_cells);
+      const int k = m_env_rng.Below(m_nk);
+      int& v = m_pool[(size_t)i * m_nk + k];
+      if (v > 0) {
+        const int t = m_nb[(size_t)i * 8 + m_env_rng.Below(4)];
+        if (t >= 0) { v--; m_pool[(size_t)t * m_nk + k]++; }
+      }
+    }
+  }
+  const int update = m_world->GetStats().GetUpdate();
+  const int ai = c.MATERIAL_AUDIT_INTERVAL.Get();
+  if (ai > 0 && update % ai == 0) Audit(false);
+  const int ci = c.MATERIAL_CENSUS_INTERVAL.Get();
+  if (ci > 0 && update % ci == 0) WriteCensus(update);
+}
+
+void cMaterial::ClearCarriedDraws()
+{
+  const Apto::Array<cOrganism*, Apto::Smart>& live = m_world->GetPopulation().GetLiveOrgList();
+  for (int i = 0; i < live.GetSize(); i++) live[i]->GetHardware().MaterialClearCarried();
+}
+
+void cMaterial::Invade(cAvidaContext& ctx, const std::string& seqstr, double frac, uint64_t inj_seed, int label,
+                       int& n, int& target, int& done, int& skipped)
+{
+  EnsureInit();
+  cPopulation& pop = m_world->GetPopulation();
+  const cInstSet& is = m_world->GetHardwareManager().GetDefaultInstSet();
+  HashPropertyMap props;
+  cHardwareManager::SetupPropertyMap(props, (const char*)is.GetInstSetName());
+  Genome genome(is.GetHardwareType(), props, GeneticRepresentationPtr(new InstructionSequence(seqstr.c_str())));
+  const std::vector<int> G = KindsOf(genome);
+
+  std::vector<cOrganism*> list;
+  const Apto::Array<cOrganism*, Apto::Smart>& live = pop.GetLiveOrgList();
+  for (int i = 0; i < live.GetSize(); i++) list.push_back(live[i]);
+  std::sort(list.begin(), list.end(), matOrgIdLess);
+  std::vector<int> cells;
+  for (size_t i = 0; i < list.size(); i++) cells.push_back(list[i]->GetCellID());
+  n = (int)cells.size();
+  target = (int)llround(n * frac);
+  cMatRng rnd(inj_seed);
+  for (int q = 0; q < target; q++) {
+    const int j = q + rnd.Below(n - q);
+    std::swap(cells[q], cells[j]);
+  }
+  done = skipped = 0;
+  for (int q = 0; q < target; q++) {
+    const int cell = cells[q];
+    cOrganism* org = pop.GetCell(cell).GetOrganism();
+    if (!org) { skipped++; continue; }
+    std::vector<long long> held(m_nk, 0);
+    if (Enabled()) {
+      org->GetHardware().MaterialAddHeld(held);
+      for (int k = 0; k < m_nk; k++) m_pool[(size_t)cell * m_nk + k] += (int)held[k];
+      std::vector<std::pair<int, int> > taken;
+      bool ok = true;
+      for (size_t i = 0; i < G.size(); i++) {
+        const int at = TakeNearThenAnywhere(cell, G[i], rnd);
+        if (at < 0) { ok = false; break; }
+        taken.push_back(std::make_pair(at, G[i]));
+      }
+      if (!ok) {
+        for (size_t i = 0; i < taken.size(); i++) Put(taken[i].first, taken[i].second);
+        for (int k = 0; k < m_nk; k++) m_pool[(size_t)cell * m_nk + k] -= (int)held[k];
+        skipped++;
+        continue;
+      }
+    }
+    m_suppress_death_return = true;
+    pop.KillOrganism(pop.GetCell(cell), ctx);
+    m_suppress_death_return = false;
+    m_suppress_inject_take = true;
+    pop.Inject(genome, Systematics::Source(Systematics::DIVISION, "", true), ctx, cell, -1, label, 0);
+    m_suppress_inject_take = false;
+    done++;
+  }
+}
+
+// Arms file: one arm per non-comment line:
+//   name out_prefix main_seed sequence frac inj_seed label rule q psub pins pdel
+void cMaterial::ForkArms(cAvidaContext& ctx, const std::string& arms_file, int parallel)
+{
+  EnsureInit();
+  std::ifstream in(arms_file.c_str());
+  if (!in) { std::cerr << "[material] cannot open arms file " << arms_file << std::endl; std::exit(5); }
+  struct Arm { std::string name, prefix, seq; long long main_seed; double frac; long long inj_seed; int label, rule; double q, psub, pins, pdel; };
+  std::vector<Arm> arms;
+  std::string line;
+  while (std::getline(in, line)) {
+    if (line.empty() || line[0] == '#') continue;
+    std::istringstream ss(line);
+    Arm a;
+    if (!(ss >> a.name >> a.prefix >> a.main_seed >> a.seq >> a.frac >> a.inj_seed >> a.label >> a.rule >> a.q >> a.psub >> a.pins >> a.pdel)) {
+      std::cerr << "[material] bad arms line: " << line << std::endl; std::exit(5);
+    }
+    arms.push_back(a);
+  }
+  if (parallel < 1) parallel = 1;
+  // audit before forking: the background must be conserved
+  const long long v0 = Audit(true);
+  FlushOutputs();
+  std::vector<pid_t> running;
+  int failures = 0;
+  for (size_t ai = 0; ai < arms.size(); ai++) {
+    while ((int)running.size() >= parallel) {
+      int st = 0;
+      pid_t p = wait(&st);
+      if (p > 0) {
+        running.erase(std::remove(running.begin(), running.end(), p), running.end());
+        if (!(WIFEXITED(st) && WEXITSTATUS(st) == 0)) failures++;
+      }
+    }
+    FlushOutputs();
+    pid_t pid = fork();
+    if (pid < 0) { std::cerr << "[material] fork failed" << std::endl; std::exit(6); }
+    if (pid == 0) {
+      // ---- child: become one arm ----
+      const Arm& a = arms[ai];
+      if (m_census) { close(fileno(m_census)); m_census = NULL; }   // parent's pipe; buffer was flushed
+      if (m_audit) { close(fileno(m_audit)); m_audit = NULL; }
+      cAvidaConfig& c = m_world->GetConfig();
+      c.COPY_DRAW_RULE.Set(a.rule);
+      c.COPY_REDRAW_Q.Set(a.q);
+      c.COPY_MAT_SUB_PROB.Set(a.psub);
+      c.COPY_MAT_INS_PROB.Set(a.pins);
+      c.COPY_MAT_DEL_PROB.Set(a.pdel);
+      m_world->GetRandom().ResetSeed((int)(a.main_seed & 0x7FFFFFFF));
+      seedStreams((uint64_t)a.main_seed * 0x9E3779B97F4A7C15ULL + 0xA4A4ULL);
+      for (int l = 0; l < MAX_LABEL; l++) m_ctr[l].Clear();
+      ClearCarriedDraws();
+      m_prefix = a.prefix;
+      openOutputs();
+      int n = 0, target = 0, done = 0, skipped = 0;
+      Invade(ctx, a.seq, a.frac, (uint64_t)a.inj_seed, a.label, n, target, done, skipped);
+      const long long v = Audit(true);
+      FILE* info = fopen((a.prefix + ".info").c_str(), "w");
+      if (info) {
+        fprintf(info, "name %s\nupdate %d\nseq %s\nmain_seed %lld\ninj_seed %lld\nlabel %d\nrule %d\nq %g\npsub %g\npins %g\npdel %g\n"
+                      "frac %g\nn %d\ntarget %d\ndone %d\nskipped %d\naudit_after_inject %lld\nbackground_audit %lld\n",
+                a.name.c_str(), m_world->GetStats().GetUpdate(), a.seq.c_str(), a.main_seed, a.inj_seed, a.label, a.rule,
+                a.q, a.psub, a.pins, a.pdel, a.frac, n, target, done, skipped, v, v0);
+        fclose(info);
+      }
+      for (int l = 0; l < MAX_LABEL; l++) m_ctr[l].Clear();
+      WriteCensus(m_world->GetStats().GetUpdate());   // t = 0 row (counts after injection)
+      return;   // continue the event loop as this arm
+    }
+    running.push_back(pid);
+  }
+  while (!running.empty()) {
+    int st = 0;
+    pid_t p = wait(&st);
+    if (p <= 0) break;
+    running.erase(std::remove(running.begin(), running.end(), p), running.end());
+    if (!(WIFEXITED(st) && WEXITSTATUS(st) == 0)) failures++;
+  }
+  std::cerr << "[material] fork parent: " << arms.size() << " arms finished, failures=" << failures << std::endl;
+  closeOutputs();
+  FILE* done = fopen((arms_file + ".done").c_str(), "w");
+  if (done) { fprintf(done, "arms %d failures %d\n", (int)arms.size(), failures); fclose(done); }
+  std::fflush(NULL);
+  _exit(failures ? 7 : 0);
+}
