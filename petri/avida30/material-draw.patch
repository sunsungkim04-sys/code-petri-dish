+/*
+ *  cMaterial.h
+ *  Avida — conserved-material copying (Code Petri Dish port, branch material-draw)
+ *
+ *  Integer per-cell, per-instruction material pools. A copy by h-copy-mat must take
+ *  the letter it writes from the pool of its own cell or a neighbour (MATERIAL_REACH);
+ *  if none is within reach the attempt is a stall: it spends the cycle and writes
+ *  nothing. Letters return to the pool on death, on overwrite, when an offspring
+ *  cannot be placed and when allocated sites are discarded at divide.
+ *  The position of the error draw relative to the material check is set by
+ *  COPY_DRAW_RULE (0 draw-first, 1 find-first, 2 draw-once; COPY_REDRAW_Q for draw-once).
+ *  Copy draws use their own random stream so that, at zero error, the three rules
+ *  give identical trajectories.
+ */
+
+#ifndef cMaterial_h
+#define cMaterial_h
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+class cWorld;
+class cOrganism;
+class cAvidaContext;
+
+namespace Avida { class Genome; }
+
+// splitmix64: small, fast, self-contained, independent of Avida's RNG
+struct cMatRng {
+  uint64_t s;
+  cMatRng() : s(0x1234567ULL) { ; }
+  explicit cMatRng(uint64_t seed) : s(seed) { ; }
+  void Seed(uint64_t seed) { s = seed; }
+  uint64_t Next() {
+    uint64_t z = (s += 0x9E3779B97F4A7C15ULL);
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+    return z ^ (z >> 31);
+  }
+  double Uniform() { return (double)(Next() >> 11) * (1.0 / 9007199254740992.0); }
+  int Below(int n) { return (int)(Uniform() * n); }
+};
+
+// Counters of copy outcomes, kept per lineage label
+struct cMatCounters {
+  long long attempts;      // executions of h-copy-mat in the population
+  long long stalls;        // attempts that wrote nothing because the letter was not within reach
+  long long nodraw_stalls; // stalls under find-first (no draw taken)
+  long long draws;         // error draws taken
+  long long reused;        // attempts that reused a carried draw (draw-once)
+  long long err_draws;     // draws that gave an error (deletion, insertion or substitution)
+  long long err_stalls;    // stalls whose letter was an erroneous one (insertion/substitution)
+  long long del;           // deletions realised (no material needed)
+  long long ins_written;   // insertions written
+  long long sub_draws;     // draws that gave a substitution
+  long long sub_written;   // substitutions written
+  long long sub_changed;   // substitutions written that changed the letter
+  long long written;       // letters written (including insertions)
+  long long gap_sum;       // cycles between consecutive attempts within a gestation
+  long long gap_n;
+  long long divides;       // successful divides
+  long long div_fail_mat;  // divides refused because un-copied sites could not be materialised
+  long long uncopied_mat;  // un-copied sites materialised at divide
+  long long extra_ret;     // copied sites beyond the offspring returned at divide
+  long long overwrite_ret; // letters returned when a held site was overwritten
+  long long placed;        // offspring placed
+  long long dropped;       // offspring that could not be placed (material returned to parent cell)
+  long long placed_changed;// placed offspring whose sequence differs from the parent's genome
+  long long placed_len;    // sum of placed offspring lengths
+  cMatCounters() { Clear(); }
+  void Clear();
+  void Add(const cMatCounters& o);
+};
+
+class cMaterial {
+public:
+  enum { MAX_LABEL = 8 };
+
+  explicit cMaterial(cWorld* world);
+  ~cMaterial();
+
+  bool Enabled() const { return m_mode != 0; }
+  void EnsureInit();
+  int NumKinds() const { return m_nk; }
+
+  // config read live (SetConfig / fork arms may change them)
+  int Rule() const;
+  double Q() const;
+  double PSub() const;
+  double PIns() const;
+  double PDel() const;
+
+  // pools
+  bool Has(int cell, int k) const;
+  int Take(int cell, int k);                  // own cell, then neighbours N,E,S,W(,NE,SE,SW,NW); returns source cell or -1
+  void Put(int cell, int k) { m_pool[(size_t)cell * m_nk + k]++; }
+  int TakeAnywhere(int k, cMatRng& rng);      // random cells, up to 200000 tries
+  int TakeNearThenAnywhere(int cell, int k, cMatRng& rng);
+  int RandomKind() { return m_copy_rng.Below(m_nk); }
+  int DrawLifespan();
+  bool FounderOn() const { return !m_founder.empty(); }
+  const std::vector<int>& Founder() const { return m_founder; }
+
+  cMatRng& CopyRng() { return m_copy_rng; }
+  cMatRng& QRng() { return m_q_rng; }
+  cMatRng& EnvRng() { return m_env_rng; }
+
+  cMatCounters& Ctr(int label) {
+    if (label < 0) label = 0;
+    if (label >= MAX_LABEL) label = MAX_LABEL - 1;
+    return m_ctr[label];
+  }
+
+  // transit (offspring between divide and placement)
+  void TransitAdd(const std::vector<int>& kinds);
+  void TransitRemove(const std::vector<int>& kinds);
+  void TransitReturn(int cell, const std::vector<int>& kinds);
+
+  // hooks
+  void OnDeath(cOrganism* org, int cell);
+  bool OnInject(cAvidaContext& ctx, int cell, const Avida::Genome& genome);
+  void OnPlaced(cOrganism* parent, cOrganism* offspring);
+  void OnDropped(cOrganism* parent, cOrganism* offspring, int parent_cell);
+  void PostUpdate(cAvidaContext& ctx);
+
+  long long Audit(bool force_print);
+  void WriteCensus(int update);
+  void FlushOutputs();
+  void Anomaly(const char* what);
+
+  // experiment actions
+  void Invade(cAvidaContext& ctx, const std::string& seq, double frac, uint64_t inj_seed, int label,
+              int& n, int& target, int& done, int& skipped);
+  void ForkArms(cAvidaContext& ctx, const std::string& arms_file, int parallel);
+  void ClearCarriedDraws();
+
+  static std::vector<int> KindsOf(const Avida::Genome& genome);
+
+  bool m_suppress_death_return;
+  bool m_suppress_inject_take;
+
+private:
+  cWorld* m_world;
+  int m_mode;
+  bool m_init;
+  int m_cells, m_nk, m_wx, m_wy, m_reach;
+  std::vector<int> m_pool;        // cells * nk
+  std::vector<int> m_nb;          // cells * 8 (N,E,S,W,NE,SE,SW,NW), -1 if none
+  std::vector<long long> m_init_kind;
+  std::vector<long long> m_transit;
+  std::vector<int> m_founder;     // census founder sequence (op codes), empty = off
+  cMatRng m_copy_rng, m_q_rng, m_env_rng;
+  cMatCounters m_ctr[MAX_LABEL];
+  long long m_audit_runs, m_audit_viol, m_anomalies, m_inject_skipped;
+  std::string m_prefix;
+  FILE* m_census;
+  FILE* m_audit;
+  void openOutputs();
+  void closeOutputs();
+  void seedStreams(uint64_t base);
+  void checkGuards();
+};
+
+#endif
